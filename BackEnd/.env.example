# ---------------------------------------------------------------------------
# 수리공학 페스타 백엔드 환경변수
# 이 파일을 .env 로 복사한 뒤 값을 채운다. .env 는 절대 커밋하지 않는다.
# ---------------------------------------------------------------------------

# 세션 토큰 서명 키. 아래 명령으로 생성:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# 관리자 비밀번호 해시. 등급마다 하나씩 둔다 — 어느 쪽을 요구할지는
# 그 사람의 역할군에 매긴 등급이 정한다 (관리자 화면 > 관리자 탭).
#
#   python scripts/hash_password.py           → 최고 관리자 · 국장단
ADMIN_PASSWORD_HASH=

#   python scripts/hash_password.py --staff   → 국원
# 비워 두면 국원도 위 비밀번호를 쓴다 (등급이 나뉘지 않는다).
STAFF_PASSWORD_HASH=

# Apps Script / 안드로이드 알림 포워더가 사용할 공유 시크릿
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
INGEST_TOKEN=

# 카카오뱅크에서 내려받은 거래내역 엑셀의 열기 비밀번호.
# 채워 두면 관리자 페이지에서 잠긴 파일을 그대로 올려도 서버가 풀어서 읽는다.
# 쉼표로 여러 개를 둘 수 있다 (비밀번호를 바꾼 뒤에도 옛 파일을 다시 올릴 수 있게).
# 비워 두면 잠긴 파일은 거절되고, 손으로 해제한 파일만 올릴 수 있다.
STATEMENT_PASSWORDS=

# 참가비 (원)
#
# 참가비는 두 겹이다 — 본 행사비가 아래에 깔리고, 뒤풀이에 가는 사람만 그 위에
# 뒤풀이비가 얹힌다. 뒤풀이비는 **별도 안내로 나중에 걷으므로** 아직 안 낸 것이
# 본 행사의 '미납'으로 번지지 않는다 (BackEnd/README.md 의 '참가비는 두 겹이다').
#
# 본 행사비 — 총학생회비 납부자 / 미납부자
FEE_COUNCIL_MEMBER=5000
FEE_NON_MEMBER=7000

# 뒤풀이 참가비. 총학생회비 납부 여부와 무관하게 같다.
# 관리자 페이지 > 대시보드에서 고칠 수 있고, 고친 값이 이 설정보다 우선한다.
FEE_AFTERPARTY=10000

# 스태프 참가비의 최초값. 0 이면 낼 것이 없는 것으로 보아 면제로 처리된다.
# 실제 금액은 관리자 페이지 > 대시보드에서 정하고, 그 값이 DB 에 남아 이 설정보다
# 우선한다. 즉 한 번 화면에서 정하면 재배포해도 유지된다.
FEE_STAFF=0

# 이름이 신청자와 맞지 않으면서 이 금액 미만인 입금은 '기타 입금'으로 분리한다.
# (참가비 전용 계좌가 아니면 소액 잡음이 확인 필요 큐를 덮어버리기 때문)
# 지워지는 것이 아니라 갈라둘 뿐이라 관리자 페이지에서 언제든 볼 수 있다. 0 이면 끈다.
#
# ⚠️ 참가비보다 **낮게** 잡아야 한다. 참가비가 5,000원이라 예전 기본값(10,000)을
#    그대로 두면 정상 참가비가 통째로 기타 입금으로 갈린다.
MINOR_DEPOSIT_THRESHOLD=3000

# 프론트엔드 도메인 (쉼표 구분). Cloudflare Pages 주소와 커스텀 도메인을 모두 넣는다.
CORS_ORIGINS=https://festa.example.com,http://localhost:5173

# SQLite 파일 위치 (컨테이너 내부 경로). 시놀로지 볼륨으로 마운트할 것.
DATA_DIR=/data

# 관리자 세션 유효시간(초)
ADMIN_SESSION_TTL=28800

# 조회/로그인 rate limit
LOOKUP_RATE_LIMIT=10 per 10 minutes
LOGIN_RATE_LIMIT=10 per 15 minutes

# 셀프 체크인과 개인 카드(/p/<token>)는 넉넉히 둔다.
# 행사장에서 수백 명이 같은 와이파이를 타면 IP 가 통째로 겹쳐,
# 조회와 같은 값을 걸면 정상 이용이 줄줄이 막힌다.
CHECKIN_RATE_LIMIT=300 per 10 minutes
CARD_RATE_LIMIT=300 per 10 minutes

# Cloudflare(1) + 시놀로지 리버스 프록시(1) = 2
TRUSTED_PROXY_HOPS=2

# 자동 매칭 끄고 전부 수동으로 처리하려면 false
AUTO_MATCH_ENABLED=true

# 안드로이드 알림 포워딩 경로.
# 카카오뱅크는 유심 없는 기기에서 로그인이 되지 않아 공기계로는 알림을 받을 수 없다.
# 입금 수집은 관리자 페이지의 거래내역 파일 업로드로만 이루어지므로 기본값은 꺼짐이다.
# 유심이 꽂힌 전용 기기를 마련했다면 true 로 켠다.
PUSH_INGEST_ENABLED=false
